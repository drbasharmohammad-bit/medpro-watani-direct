<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Build 1.2.28: the update-required screen downloads the new
         APK and hands it to the system installer (data/AppUpdate). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 1.2.23: re-seed the local study-reminder alarms after reboot
         (alarms do not survive a restart on their own). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 1.2.30 lock-screen features: the live focus-session bar runs
         as a foreground service (specialUse type — a student-started
         study timer), and the strong study alarm may present a
         full-screen page over the lock screen (on Android 14+ the
         student grants this in system settings; the app falls back
         to a plain notification without it). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Root-manager package visibility for the whole-app root block
         (build 1.2.8, RootBlock): on Android 11+ an app can only see
         packages it declares here. Scoped <queries> only — no
         QUERY_ALL_PACKAGES permission. Keep in sync with
         RootBlock.ROOT_PACKAGES. -->
    <queries>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="io.github.vvb2060.magisk" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.noshufou.android.su" />
        <package android:name="com.koushikdutta.superuser" />
        <package android:name="com.thirdparty.superuser" />
        <package android:name="com.yellowes.su" />
        <package android:name="com.kingroot.kinguser" />
        <package android:name="com.kingo.root" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="me.bmax.apatch" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name="sy.medpro.watani.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="sy.medpro.watani.ui.push.WataniMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 1.2.23 local study reminders: the daily alarm receiver
             (own-app PendingIntents only, hence exported=false), the
             boot/package-replaced re-seeder, and the home-screen
             study widget. -->
        <receiver
            android:name="sy.medpro.watani.notify.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="sy.medpro.watani.action.REMINDER_FIRE" />
                <action android:name="sy.medpro.watani.action.MIDNIGHT_TICK" />
                <action android:name="sy.medpro.watani.action.MISTAKES_FIRE" />
                <action android:name="sy.medpro.watani.action.QUESTION_FIRE" />
                <action android:name="sy.medpro.watani.action.REMINDER_SNOOZE" />
            </intent-filter>
        </receiver>
        <!-- 1.2.30: live focus-session bar — foreground service
             (specialUse: a pomodoro study timer the student starts
             himself) plus its lock-screen action receiver. -->
        <service
            android:name="sy.medpro.watani.notify.FocusSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="مؤقت تركيز للدراسة (بومودورو) يبدؤه الطالب بنفسه، بعدّاد حي وأزرار تحكم على شاشة القفل" />
        </service>
        <receiver
            android:name="sy.medpro.watani.notify.FocusActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="sy.medpro.watani.action.FOCUS_TOGGLE" />
                <action android:name="sy.medpro.watani.action.FOCUS_FINISH" />
            </intent-filter>
        </receiver>
        <!-- 1.2.30: the strong study alarm's full-screen page over
             the lock screen (opened only by the notification's
             full-screen intent). -->
        <activity
            android:name="sy.medpro.watani.ui.notify.StudyAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.MyApplication" />
        <receiver
            android:name="sy.medpro.watani.notify.BootRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- عائلة ويدجتات 1.2.24: صغير (العدّاد فقط) / متوسط
             (العدّاد + أهداف اليوم) / كبير (كل شيء، قابل للتكبير).
             الويدجت الأحادي من 1.2.23 أُزيل نهائيًا. -->
        <receiver
            android:name="sy.medpro.watani.ui.widget.CountdownWidgetProvider"
            android:exported="true"
            android:label="@string/widget_countdown_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown_info" />
        </receiver>
        <receiver
            android:name="sy.medpro.watani.ui.widget.DayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_day_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day_info" />
        </receiver>
        <receiver
            android:name="sy.medpro.watani.ui.widget.DayWidgetLargeProvider"
            android:exported="true"
            android:label="@string/widget_day_large_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day_large_info" />
        </receiver>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="watani_general" />
    </application>

</manifest>
