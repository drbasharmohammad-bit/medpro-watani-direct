<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch-window background: replaces the plain grey window the student
  sees on cold start before Compose draws. The solid colour is the
  artwork tile's EXACT colour (#2D1015), so the artwork's square edge
  disappears completely (Nov 2026, doctor's order: exactly one colour,
  no visible square). The video splash follows in the same dark family.
  The artwork itself is used as-is, never redesigned.
  No animation here by design — window backgrounds are static; the
  animation lives in the video splash.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#2D1015" />
        </shape>
    </item>
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/ic_launcher_artwork"
            android:gravity="fill" />
    </item>
</layer-list>
