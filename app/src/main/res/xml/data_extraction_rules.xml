<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules — see backup_rules.xml: since the 21 Nov
  2026 audit (SEC-S2) the manifest disables backup/transfer
  entirely (allowBackup="false"); these exclusions remain as
  defence in depth only. An activation never migrates to a new
  phone via transfer; the new device activates (or restores at
  sign-in) through the gateway like any other device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="watani_activation.xml" />
        <exclude domain="sharedpref" path="watani_downloaded_sections.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="watani_activation.xml" />
        <exclude domain="sharedpref" path="watani_downloaded_sections.xml" />
    </device-transfer>
</data-extraction-rules>
