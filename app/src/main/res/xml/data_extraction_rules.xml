<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules (unified fixes build, Nov 2026): the same
  sensitive stores excluded from cloud backup are also excluded from
  device-to-device transfer — an activation must never migrate to a
  new phone via transfer; the new device activates (or restores at
  sign-in) through the gateway like any other device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="watani_activation.xml" />
        <exclude domain="sharedpref" path="watani_downloaded_sections.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="watani_activation.xml" />
        <exclude domain="sharedpref" path="watani_downloaded_sections.xml" />
    </device-transfer>
</data-extraction-rules>
