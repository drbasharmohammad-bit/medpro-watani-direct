<?xml version="1.0" encoding="utf-8"?>
<!-- تركيز اليوم 2×2 — تصميم 8: وقت التركيز + زر بدء جلسة. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/widget_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/widget_glass_title"
            android:fontFamily="@font/thmanyah_sans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تركيز اليوم"
            android:textColor="#C2A059"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_focus_big"
            android:fontFamily="@font/thmanyah_sans"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:textColor="#FAF6F0"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_focus_start"
            android:fontFamily="@font/thmanyah_sans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_gold_pill"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="ابدأ جلسة"
            android:textColor="#2E0812"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
