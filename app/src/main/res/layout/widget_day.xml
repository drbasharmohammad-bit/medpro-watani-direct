<?xml version="1.0" encoding="utf-8"?>
<!-- الويدجت المتوسط v3 (1.2.25): عمودان فوق صورة معلم مدموجة —
     يمين: العدّ التنازلي (أيام + كرونومتر بلا وسوم + التاريخ)،
     يسار: أسئلة اليوم (تقدم + هدف) + زرّان سريعان يفتح كلٌّ
     منهما شاشته المقصودة داخل التطبيق. كما بالنموذج المعتمد.
     إصلاح قصّ (16 نوفمبر 14:43): أزرار عمودية (أيقونة فوق
     نص سطر واحد) وعمود أزرار أعرض — النص لا يُقصّ أبدًا. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_photo_frame"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/widget_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_photo_frame"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/widget_countdown_block"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.95"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العدّ التنازلي للإمتحان"
                android:textColor="#D8CDB8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/widget_days_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E9C767"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="يومًا"
                    android:textColor="#FAF4E6"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/widget_chip_bg"
                android:gravity="center_horizontal"
                android:layoutDirection="ltr"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <!-- رقم زمني وحده بلا وسوم وحدات — بأمر الدكتور
                     16 نوفمبر 14:43. -->
                <Chronometer
                    android:id="@+id/widget_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#FAF4E6"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#D8CDB8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_expired"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="حان موعد الامتحان — بالتوفيق"
                android:textColor="#FAF4E6"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_landmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D8CDB8"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="#59D4AF37" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/widget_questions_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أسئلة اليوم"
                    android:textColor="#FAF4E6"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_goal_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FAF4E6"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/widget_goal_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="5dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress" />

                <TextView
                    android:id="@+id/widget_goal_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#D8CDB8"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/widget_buttons_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- أزرار عمودية (أيقونة فوق النص) بسطر واحد
                     دائمًا: بعرض العمود الضيق كان النص الأفقي
                     بجانب الأيقونة يُقصّ على أجهزة MIUI
                     (حكم جهاز الدكتور 16 نوفمبر 14:43). -->
                <LinearLayout
                    android:id="@+id/widget_btn_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/widget_chip_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:id="@+id/widget_btn_1_icon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_btn_1_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"
                        android:textColor="#FAF4E6"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/widget_btn_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/widget_chip_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:id="@+id/widget_btn_2_icon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_btn_2_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"
                        android:textColor="#FAF4E6"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_frame" />
</FrameLayout>
