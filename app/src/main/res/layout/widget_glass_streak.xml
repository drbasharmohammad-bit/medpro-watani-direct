<?xml version="1.0" encoding="utf-8"?>
<!-- سلسلة الأيام 2×2 — تصميم 4: الرقم + نقاط الأسبوع السبعة. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/widget_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/widget_glass_title"
            android:fontFamily="@font/thmanyah_sans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="سلسلة الأيام"
            android:textColor="#C2A059"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_streak_number"
                android:fontFamily="@font/thmanyah_sans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FAF6F0"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_streak_caption"
                android:fontFamily="@font/thmanyah_sans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="يومًا"
                android:textColor="#DED2C0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_dots"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:contentDescription="@null" />
    </LinearLayout>
</FrameLayout>
