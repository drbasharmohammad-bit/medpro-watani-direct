<?xml version="1.0" encoding="utf-8"?>
<!-- زوادة اليوم 4×2 — تصميم 6: نصيحة معتمدة من حزم «زوادة الطالب» + اسم صاحبها بخط ناعم صغير. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/widget_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/widget_glass_title"
            android:fontFamily="@font/thmanyah_sans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="زوادة اليوم"
            android:textColor="#C2A059"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tip_text"
            android:fontFamily="@font/thmanyah_sans"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:textColor="#FAF6F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tip_empty"
            android:fontFamily="@font/thmanyah_sans"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="زوادة زملائك في طريقها إليك — افتح «زوادة الطالب» وكن أول من يضيف"
            android:textColor="#DED2C0"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_tip_author"
            android:fontFamily="@font/thmanyah_sans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C6BAA8"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
