<?xml version="1.0" encoding="utf-8"?>
<!-- أزرار سريعة 4×1 — تصميم 7: كل زر يفتح شاشته المقصودة. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/widget_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_buttons_row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/widget_btn_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_btn_1_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_btn_1_text"
                android:fontFamily="@font/thmanyah_sans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#FAF6F0"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_btn_2_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_btn_2_text"
                android:fontFamily="@font/thmanyah_sans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#FAF6F0"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_btn_3_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_btn_3_text"
                android:fontFamily="@font/thmanyah_sans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#FAF6F0"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_btn_4_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_btn_4_text"
                android:fontFamily="@font/thmanyah_sans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#FAF6F0"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
