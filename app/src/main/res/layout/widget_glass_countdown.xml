<?xml version="1.0" encoding="utf-8"?>
<!-- العدّاد التنازلي 4×2 — تصميم 1 من عائلة الزجاج v4 (1.2.51): عنوان ذهبي، أيام كبيرة عاجية، فاصل، كرونومتر ذهبي فاتح بلا وسوم وحدات. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@null"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/widget_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/widget_glass_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/thmanyah_sans"
            android:text="العد التنازلي للامتحان الوطني"
            android:textColor="#C2A059"
            android:textSize="14sp"
            android:textStyle="bold"
            android:shadowColor="#73000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_days_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_days"
                    android:fontFamily="@font/thmanyah_sans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FAF6F0"
                    android:textSize="52sp"
                    android:textStyle="bold"
            android:shadowColor="#73000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

                <TextView
                    android:id="@+id/widget_days_caption"
                    android:fontFamily="@font/thmanyah_sans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="يومًا متبقيًا"
                    android:textColor="#DED2C0"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="8dp"
                android:background="#33FFFFFF" />

            <LinearLayout
                android:id="@+id/widget_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layoutDirection="ltr"
                android:orientation="vertical">

                <Chronometer
                    android:id="@+id/widget_chrono"
                    android:fontFamily="@font/thmanyah_sans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E8CD96"
                    android:textSize="26sp"
                    android:textStyle="bold"
            android:shadowColor="#73000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

                <TextView
                    android:id="@+id/widget_chip_caption"
                    android:fontFamily="@font/thmanyah_sans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="يُحدّث كل ثانية"
                    android:textColor="#C6BAA8"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_expired"
            android:fontFamily="@font/thmanyah_sans"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="حان موعد الامتحان — بالتوفيق"
            android:textColor="#FAF6F0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
